{
  "name": "banking-e2e-bdd",
  "version": "1.0.0",
  "description": "BDD (Cucumber + Playwright) E2E automation framework with Allure reporting",
  "scripts": {
    "bdd:gen": "bddgen",
    "test": "npm run bdd:gen && playwright test",
    "test:headed": "npm run bdd:gen && playwright test --headed",
    "test:chromium": "npm run bdd:gen && playwright test --project=chromium",
    "report:allure:generate": "allure generate reports/allure-results --clean -o reports/allure-report",
    "report:allure:open": "allure open reports/allure-report",
    "report:allure": "npm run report:allure:generate && npm run report:allure:open",
    "report:html": "playwright show-report reports/html-report",
    "posttest": "npm run report:allure:generate"
  },
  "keywords": [
    "playwright",
    "cucumber",
    "bdd",
    "allure"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "allure-commandline": "^2.34.0",
    "allure-js-commons": "^3.1.2",
    "allure-playwright": "^3.1.2",
    "dotenv": "^16.4.5",
    "playwright-bdd": "^9.2.1",
    "typescript": "^5.6.3"
  }
}
